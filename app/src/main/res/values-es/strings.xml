    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> es una capa de traducción para DirectX 1-11 a OpenGL.<br /><br />
        <i><b>DXVK</b></i> es una capa de traducción para Direct3D 9-11 a Vulkan.<br /><br />
        <i><b>D8VK</b></i> es una capa de traducción para Direct3D 8 a Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> es una implementación de DirectDraw para mejor compatibilidad con juegos clásicos.
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        Manejo de banderas en opcodes CALL/RET<br /><br />
        <b>0</b> : Trata CALL/RET como si nunca necesitaran banderas (más rápido, inestable)<br />
        <b>1</b> : La mayoría de RET necesitarán banderas, la mayoría de CALLS no<br />
        <b>2</b> : Todos los CALL/RET necesitarán banderas (más lento)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_fastnan">Generación de -NAN como en x86</string>
    <string name="box86_64_env_var_help__dynarec_fastround">Generación de redondeo preciso de x86</string>
    <string name="box86_64_env_var_help__dynarec_x87double">Uso de Float/Double para emulación x86</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec construyendo BigBlock<br /><br />
        <b>0</b> : No intentar construir bloques lo más grandes posible<br />
        <b>1</b> : Construir bloques Dynarec lo más grandes posible<br />
        <b>2</b> : Construir bloques Dynarec más grandes (continuar cuando los bloques se superponen, pero solo para bloques en memoria elf)<br />
        <b>3</b> : Construir bloques Dynarec más grandes (continuar cuando los bloques se superponen, para todo tipo de memoria)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        Simulación de modelo de memoria fuerte<br /><br />
        <b>0</b> : No intentar nada especial<br />
        <b>1</b> : Habilitar algunas barreras de memoria al escribir en memoria (en algunos opcodes MOV)<br />
        <b>2</b> : Todo lo de 1 más una barrera de memoria en cada escritura a memoria usando MOV<br />
        <b>2</b> : Todo lo de 2 más barreras de memoria al leer de memoria y en algunos opcodes SSE/SSE2
    ]]></string>
