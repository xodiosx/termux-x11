    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> est une couche de traduction pour DirectX 1-11 vers OpenGL.<br /><br />
        <i><b>DXVK</b></i> est une couche de traduction pour Direct3D 9-11 vers Vulkan.<br /><br />
        <i><b>D8VK</b></i> est une couche de traduction pour Direct3D 8 vers Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> est une implémentation de DirectDraw pour une meilleure compatibilité avec les jeux classiques.
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        Gestion des drapeaux sur les opcodes CALL/RET<br /><br />
        <b>0</b> : Traite CALL/RET comme s\'ils n\'avaient jamais besoin de drapeaux (plus rapide, instable)<br />
        <b>1</b> : La plupart des RET auront besoin de drapeaux, la plupart des CALLS non<br />
        <b>2</b> : Tous les CALL/RET auront besoin de drapeaux (plus lent)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_fastnan">Génération de -NAN comme sur x86</string>
    <string name="box86_64_env_var_help__dynarec_fastround">Génération d\'un arrondi précis x86</string>
    <string name="box86_64_env_var_help__dynarec_x87double">Utilisation de Float/Double pour l\'émulation x86</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec construisant BigBlock<br /><br />
        <b>0</b> : Ne pas essayer de construire des blocs aussi grands que possible<br />
        <b>1</b> : Construire des blocs Dynarec aussi grands que possible<br />
        <b>2</b> : Construire des blocs Dynarec plus grands (continuer lorsque les blocs se chevauchent, mais uniquement pour les blocs en mémoire elf)<br />
        <b>3</b> : Construire des blocs Dynarec plus grands (continuer lorsque les blocs se chevauchent, pour tous types de mémoire)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        Simulation du modèle de mémoire forte<br /><br />
        <b>0</b> : Ne rien essayer de spécial<br />
        <b>1</b> : Activer certaines barrières mémoire lors de l\'écriture en mémoire (sur certains opcodes MOV)<br />
        <b>2</b> : Tout ce qui est en 1 plus une barrière mémoire sur chaque écriture en mémoire utilisant MOV<br />
        <b>2</b> : Tout ce qui est en 2 plus des barrières mémoire lors de la lecture en mémoire et sur certains opcodes SSE/SSE2
    ]]></string>
