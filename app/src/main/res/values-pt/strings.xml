    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> é uma camada de tradução para DirectX 1-11 para OpenGL.<br /><br />
        <i><b>DXVK</b></i> é uma camada de tradução para Direct3D 9-11 para Vulkan.<br /><br />
        <i><b>D8VK</b></i> é uma camada de tradução para Direct3D 8 para Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> é uma implementação de DirectDraw para melhor compatibilidade com jogos clássicos.
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        Manipulação de flags em opcodes CALL/RET<br /><br />
        <b>0</b> : Trata CALL/RET como se nunca precisassem de flags (mais rápido, instável)<br />
        <b>1</b> : A maioria dos RET precisará de flags, a maioria dos CALLS não<br />
        <b>2</b> : Todos os CALL/RET precisarão de flags (mais lento)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_fastnan">Geração de -NAN como no x86</string>
    <string name="box86_64_env_var_help__dynarec_fastround">Geração de arredondamento preciso do x86</string>
    <string name="box86_64_env_var_help__dynarec_x87double">Uso de Float/Double para emulação x86</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec construindo BigBlock<br /><br />
        <b>0</b> : Não tente construir blocos o maior possível<br />
        <b>1</b> : Construa blocos Dynarec o maior possível<br />
        <b>2</b> : Construa blocos Dynarec maiores (continue quando os blocos se sobrepõem, mas apenas para blocos na memória elf)<br />
        <b>3</b> : Construa blocos Dynarec maiores (continue quando os blocos se sobrepõem, para todos os tipos de memória)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        Simulação do modelo de memória forte<br /><br />
        <b>0</b> : Não tente nada especial<br />
        <b>1</b> : Habilite algumas barreiras de memória ao escrever na memória (em alguns opcodes MOV)<br />
        <b>2</b> : Tudo em 1 mais uma barreira de memória em cada escrita na memória usando MOV<br />
        <b>2</b> : Tudo em 2 mais barreiras de memória ao ler da memória e em alguns opcodes SSE/SSE2
    ]]></string>
